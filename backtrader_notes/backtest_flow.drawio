        <mxCell id="db-start" value="&lt;b&gt;START&lt;/b&gt;&#xa;python run.py qpmmt_vn30 --mode db" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="550" y="70" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Config -->
        <mxCell id="db-config" value="&lt;b&gt;Load Config&lt;/b&gt;&#xa;CORE_SOURCE = 'db'&#xa;Start: DB_MODE_START_DATE (2025-12-13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="160" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Data Load -->
        <mxCell id="db-data" value="&lt;b&gt;_load_data()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="570" y="250" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Two Data Sources -->
        <mxCell id="db-trino" value="&lt;b&gt;TrinoDailyLoader&lt;/b&gt;&#xa;Historical OHLCV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="db-fiin" value="&lt;b&gt;FiinDataLoader&lt;/b&gt;&#xa;get_historical_price_at_time()&#xa;Market check @ 13:55" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="310" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Merge -->
        <mxCell id="db-merge" value="&lt;b&gt;Merge Data&lt;/b&gt;&#xa;market_check_price from FiinQuant&#xa;Fallback: price_adj_closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="410" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Strategy Loop -->
        <mxCell id="db-loop" value="&lt;b&gt;Strategy.next() Loop&lt;/b&gt;&#xa;From DB_MODE_START_DATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="500" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Date Filter -->
        <mxCell id="db-filter" value="&lt;b&gt;Date Filter&lt;/b&gt;&#xa;current_date &gt;= DB_MODE_START_DATE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="530" y="580" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Continuity Check -->
        <mxCell id="db-cont" value="&lt;b&gt;check_date_continuity()&lt;/b&gt;&#xa;Verify DB state matches current data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="680" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Process Previous Trades -->
        <mxCell id="db-prev" value="&lt;b&gt;process_trades_for_day()&lt;/b&gt;&#xa;Execute pending trades from previous day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="760" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Rebalance Check -->
        <mxCell id="db-rebal" value="&lt;b&gt;should_rebalance()?&lt;/b&gt;&#xa;Friday + 2-week interval" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="840" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Yes Branch -->
        <mxCell id="db-calc" value="&lt;b&gt;Calculate Scores&lt;/b&gt;&#xa;Dynamic calculation&#xa;(temp indicators)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="755" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="db-orders" value="&lt;b&gt;save_orders()&lt;/b&gt;&#xa;Insert to PostgreSQL&#xa;+ CSV backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="840" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Post Process -->
        <mxCell id="db-post" value="&lt;b&gt;_post_process()&lt;/b&gt;&#xa;Check: tomorrow == today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="940" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="db-end" value="&lt;b&gt;END&lt;/b&gt;&#xa;process_daily_trades()&#xa;cerebro.stop()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="940" width="180" height="70" as="geometry" />
