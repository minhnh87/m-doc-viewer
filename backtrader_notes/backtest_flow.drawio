          <mxGeometry x="490" y="955" width="40" height="20" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="bt-arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="bt-start" target="bt-config">
