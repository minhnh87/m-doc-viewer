  <diagram id="bt_db-flow" name="bt_db - Historical Backtest">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="bt-title" value="&lt;b&gt;bt_db MODE - Historical Backtest Flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="400" height="30" as="geometry" />
