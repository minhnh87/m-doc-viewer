          <mxGeometry x="510" y="340" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Filter -->
        <mxCell id="bt-filter" value="&lt;b&gt;_filter_short_tickers()&lt;/b&gt;&#xa;Remove stocks with &lt; max_period bars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="530" y="460" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Setup Cerebro -->
        <mxCell id="bt-cerebro" value="&lt;b&gt;_setup_cerebro()&lt;/b&gt;&#xa;Create bt.Cerebro()&#xa;Add QPMMTStrategy&#xa;Add CSVDataFeed per ticker&#xa;Set initial_cash (10B VND)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="510" y="540" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Strategy Loop -->
        <mxCell id="bt-loop" value="&lt;b&gt;Strategy.next() Loop&lt;/b&gt;&#xa;For each bar (2022-10-05 to 2024-12-31)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="660" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Rebalance? -->
        <mxCell id="bt-rebal" value="&lt;b&gt;should_rebalance()?&lt;/b&gt;&#xa;Friday + 2-week interval" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="740" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Yes Branch -->
        <mxCell id="bt-calc" value="&lt;b&gt;Calculate Scores&lt;/b&gt;&#xa;rs1 = self.inds[d]['rs1'][0]&#xa;(Pre-computed indicators)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="755" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bt-select" value="&lt;b&gt;Select Portfolio&lt;/b&gt;&#xa;Top 15% by momentum&#xa;Equal-weight allocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="835" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bt-orders" value="&lt;b&gt;Generate Orders&lt;/b&gt;&#xa;save_orders() to CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="915" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Process Orders -->
        <mxCell id="bt-process" value="&lt;b&gt;Process Pending Orders&lt;/b&gt;&#xa;Execute buy/sell signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
