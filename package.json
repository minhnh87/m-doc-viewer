{
  "name": "markdown-reader",
  "version": "2.0.0",
  "description": "Static markdown reader — opens over file:// and talks to m-local-api",
  "type": "module",
  "scripts": {
    "build:md": "esbuild public/view.js --bundle --format=iife --loader:.css=text --outfile=public/app.bundle.js",
    "build:claude": "esbuild public/claude/view.js --bundle --format=iife --loader:.css=text --outfile=public/claude.bundle.js",
    "build": "npm run build:md && npm run build:claude",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
