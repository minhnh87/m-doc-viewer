{
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      }
    }
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "env": {
    "ECC_HOOK_PROFILE": "standard",
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force,pre:config-protection,pre:bash:dispatcher,post:edit:design-quality-check,post:edit:console-warn,stop:check-console-log,pre:write:doc-file-warning"
  }
}
